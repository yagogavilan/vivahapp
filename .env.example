# Copie para .env e preencha com os dados do seu projeto no Supabase
# (Project Settings → API). Sem estas duas chaves o app abre em modo demonstração.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# E-mail de contato mostrado na tela de privacidade.
EXPO_PUBLIC_SUPPORT_EMAIL=contato@vivah.com.br

# Força o modo demonstração mesmo com as chaves preenchidas (1 = sim).
# EXPO_PUBLIC_DEMO=1
